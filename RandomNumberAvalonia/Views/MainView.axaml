<UserControl
    x:Class="RandomNumberAvalonia.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:RandomNumberAvalonia.Converters"
    xmlns:views="clr-namespace:RandomNumberAvalonia.Views"
    xmlns:vm="clr-namespace:RandomNumberAvalonia.ViewModels"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--  移动端布局：上方内容区 + 底部导航栏，横竖屏自适应  -->
    <Grid RowDefinitions="*,Auto" Background="{DynamicResource AppBgBrush}">

        <Grid Grid.Row="0">
            <views:HomePageView IsVisible="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Home}" />
            <views:HistoryPageView IsVisible="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=History}" />
            <views:SettingsPageView IsVisible="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,6,10,8">
            <Grid ColumnDefinitions="*,*,*">
                <RadioButton
                    Grid.Column="0"
                    Theme="{StaticResource NavBarItemTheme}"
                    GroupName="NavBar"
                    IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Home, Mode=TwoWay}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Spacing="4">
                        <PathIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            Data="{StaticResource HomeIconGeometry}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="首页" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    Grid.Column="1"
                    Theme="{StaticResource NavBarItemTheme}"
                    GroupName="NavBar"
                    IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=History, Mode=TwoWay}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Spacing="4">
                        <PathIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            Data="{StaticResource HistoryIconGeometry}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="历史" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    Grid.Column="2"
                    Theme="{StaticResource NavBarItemTheme}"
                    GroupName="NavBar"
                    IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Settings, Mode=TwoWay}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Spacing="4">
                        <PathIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            Data="{StaticResource SettingsIconGeometry}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="设置" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
