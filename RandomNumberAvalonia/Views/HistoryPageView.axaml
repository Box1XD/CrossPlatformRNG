<UserControl
    x:Class="RandomNumberAvalonia.Views.HistoryPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:RandomNumberAvalonia.ViewModels"
    x:DataType="vm:MainViewModel"
    d:DesignHeight="760"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <!--  历史记录页：按启动会话分组，每次启动一组，新的在前  -->
    <Grid RowDefinitions="Auto,*">

        <StackPanel
            Grid.Row="0"
            MaxWidth="560"
            Margin="24,20,24,6"
            HorizontalAlignment="Stretch">
            <TextBlock Classes="pageTitle" Text="历史记录" />
            <TextBlock
                Margin="0,4,0,0"
                Classes="pageSubtitle"
                Text="{Binding HistorySummary}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="560"
                Margin="16,4,16,20"
                HorizontalAlignment="Stretch">

                <!--  空状态  -->
                <StackPanel
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !HasHistory}"
                    Spacing="10">
                    <PathIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Data="{StaticResource HistoryIconGeometry}"
                        Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="pageSubtitle"
                        Text="暂无记录，去首页生成一个随机数吧" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding HistorySessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistorySessionViewModel">
                            <Border
                                Margin="0,0,0,12"
                                Classes="card">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="{DynamicResource AppAccentBrush}" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                Text="{Binding Header}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="pageSubtitle"
                                            Text="{Binding CountText}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                                <Border
                                                    Margin="0,0,8,8"
                                                    Padding="12,6"
                                                    Background="{DynamicResource AppAccentSoftBrush}"
                                                    CornerRadius="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                            Text="{Binding ValueText}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="pageSubtitle"
                                                            Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
